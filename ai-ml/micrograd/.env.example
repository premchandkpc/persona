# Environment Configuration for AI/ML Projects

# Python
PYTHONUNBUFFERED=1

# Jupyter
JUPYTER_ENABLE_LAB=1
JUPYTER_TOKEN=

# Logging
LOG_LEVEL=INFO

# Data
DATA_DIR=./data
OUTPUT_DIR=./output

# Model
RANDOM_SEED=42
BATCH_SIZE=32
LEARNING_RATE=0.01
EPOCHS=100

# Hardware
USE_GPU=false
DEVICE=cpu

# Development
DEBUG=false
VERBOSE=false
